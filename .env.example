LLM_API_KEY=
NGINX_PORT=8088
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zzl_agents

API_APP_NAME=ZZLAgents API
API_ENV=development
API_VERSION=0.1.0
API_PREFIX=/api
# API_PORT=8000

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=["http://localhost:8088","http://127.0.0.1:8088","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# UI_PORT=3000
UI_API_PROXY_URL=http://api:8000/api/:path*

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/zzl_agents